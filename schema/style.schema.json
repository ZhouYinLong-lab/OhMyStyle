{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZhouYinLong-lab/OhMyStyle/schema/style.schema.json",
  "title": "OhMyStyle Style Package",
  "description": "Machine-readable manifest for a reproducible photography, painting, or visual style package.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "version",
    "type",
    "summary",
    "visual_identity",
    "technical",
    "avoid",
    "files"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "type": {
      "type": "string",
      "enum": ["photography", "painting", "hybrid", "illustration", "design"]
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "visual_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mood", "color", "lighting", "composition", "texture"],
      "properties": {
        "mood": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "color": {
          "type": "object",
          "additionalProperties": true,
          "required": ["saturation", "contrast", "temperature", "dominant_colors"],
          "properties": {
            "saturation": {"type": "string", "minLength": 1},
            "contrast": {"type": "string", "minLength": 1},
            "temperature": {"type": "string", "minLength": 1},
            "dominant_colors": {
              "type": "array",
              "minItems": 3,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              }
            }
          }
        },
        "lighting": {
          "type": "object",
          "additionalProperties": true,
          "required": ["source", "quality", "direction"],
          "properties": {
            "source": {"type": "string", "minLength": 1},
            "quality": {"type": "string", "minLength": 1},
            "direction": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            }
          }
        },
        "composition": {
          "type": "object",
          "additionalProperties": true,
          "required": ["framing", "principles", "camera_angle"],
          "properties": {
            "framing": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "principles": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
            "camera_angle": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "texture": {
          "type": "object",
          "additionalProperties": true,
          "required": ["sharpness", "grain", "surface"],
          "properties": {
            "sharpness": {"type": "string", "minLength": 1},
            "grain": {"type": "string", "minLength": 1},
            "surface": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "technical": {
      "type": "object",
      "additionalProperties": true,
      "required": ["parameters_file"],
      "properties": {
        "parameters_file": {"type": "string", "minLength": 1}
      }
    },
    "avoid": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readme",
        "style",
        "references",
        "palette",
        "composition",
        "technique",
        "prompts",
        "accepted_examples",
        "rejected_examples",
        "provenance",
        "sources",
        "version"
      ],
      "properties": {
        "readme": {"type": "string", "minLength": 1},
        "style": {"type": "string", "minLength": 1},
        "references": {"type": "string", "minLength": 1},
        "palette": {"type": "string", "minLength": 1},
        "composition": {"type": "string", "minLength": 1},
        "technique": {"type": "string", "minLength": 1},
        "prompts": {"type": "string", "minLength": 1},
        "accepted_examples": {"type": "string", "minLength": 1},
        "rejected_examples": {"type": "string", "minLength": 1},
        "provenance": {"type": "string", "minLength": 1},
        "sources": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  }
}
