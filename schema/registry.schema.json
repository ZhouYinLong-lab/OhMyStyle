{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZhouYinLong-lab/OhMyStyle/schema/registry.schema.json",
  "title": "OhMyStyle Core Resource Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_by", "packages"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "generated_by": {"type": "string", "const": "tools/build-registry.py"},
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["resource_id", "name", "kind", "domain", "package_path", "maturity", "focus_dimensions", "reference_count", "accepted_example_count", "rejected_example_count"],
        "properties": {
          "resource_id": {"type": "string"},
          "name": {"type": "string"},
          "kind": {"type": "string"},
          "domain": {"type": "string"},
          "package_path": {"type": "string"},
          "maturity": {"type": "string", "enum": ["L0", "L1", "L2", "L3", "L4"]},
          "focus_dimensions": {"type": "array", "items": {"type": "string"}},
          "reference_count": {"type": "integer", "minimum": 0},
          "accepted_example_count": {"type": "integer", "minimum": 0},
          "rejected_example_count": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
