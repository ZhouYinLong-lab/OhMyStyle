{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZhouYinLong-lab/OhMyStyle/schema/render-task.schema.json",
  "title": "OhMyStyle Render Task",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "subject", "output", "constraints"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "package": {"type": "string"},
    "subject": {"type": "string", "minLength": 1},
    "brief": {"type": "string"},
    "references": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package": {"type": "string"},
        "mode": {"type": "string", "enum": ["none", "palette", "primary", "all"]}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspect_ratio"],
      "properties": {
        "aspect_ratio": {"type": "string"},
        "target_aspects": {"type": "array", "items": {"type": "string"}},
        "safe_zone": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "masking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": {"type": "boolean"},
            "strategy": {"type": "string", "enum": ["color_threshold", "color_threshold_plus_protected_classes"]},
            "adapter": {"type": "string"},
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "target_hex", "role", "safety_profile"],
                "properties": {
                  "id": {"type": "string"},
                  "target_hex": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
                  "role": {"type": "string", "enum": ["subject", "background", "product"]},
                  "safety_profile": {"type": "string", "enum": ["generic", "person", "reflective"]},
                  "protected_classes": {"type": "array", "items": {"type": "string"}},
                  "lab_radius": {"type": "number", "exclusiveMinimum": 0},
                  "lstar_tolerance": {"type": "number", "minimum": 0},
                  "exclude_specular": {"type": "boolean"},
                  "min_component_area": {"type": "integer", "minimum": 1}
                }
              }
            },
            "fail_closed": {"type": "boolean"}
          }
        }
      }
    }
  }
}
